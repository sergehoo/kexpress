# =============================================================================
# Kaydan Express — variables d'environnement de PRODUCTION
# Copier ces clés dans l'onglet « Environment » de Dokploy (ou un .env non versionné).
# Ne JAMAIS committer de vrais secrets.
# =============================================================================

# --- Django (obligatoire) ---------------------------------------------------
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changez-moi-en-une-cle-longue-et-aleatoire
# Domaines publics (séparés par des virgules), sans schéma.
ALLOWED_HOSTS=app.exemple.com,api.exemple.com
# Origines de confiance CSRF (avec schéma https).
CSRF_TRUSTED_ORIGINS=https://app.exemple.com,https://api.exemple.com
# Origines autorisées pour le navigateur (frontend → API).
CORS_ALLOWED_ORIGINS=https://app.exemple.com

# --- Base de données (PostgreSQL géré par le service db) --------------------
POSTGRES_DB=kexpress
POSTGRES_USER=kexpress
POSTGRES_PASSWORD=changez-moi-mot-de-passe-postgres

# --- Frontend (figé au BUILD de l'image Next.js) ----------------------------
# Doit pointer vers le domaine backend (provisionné dans Dokploy) suffixé par /api,
# TOUJOURS en https en production (sinon mixed-content : XHR/WS bloqués par le navigateur).
# Le WebSocket en est dérivé automatiquement (wss://api.exemple.com/ws/...).
# ⚠ Variable figée à la compilation : si elle change, reconstruire le frontend
#   (Dokploy : « Rebuild » ; en local : docker compose up --build frontend).
NEXT_PUBLIC_API_BASE=https://api.exemple.com/api

# --- Invitations et limitation de débit (backend) -------------------------
# Adresse PUBLIQUE du frontend : lien des emails d'invitation (définition du mot de passe).
# Obligatoire en production : sans elle (ou sans envoi SMTP, NOTIFY_EMAIL_ENABLED=True), la
# création de compte est refusée plutôt que de laisser un compte inutilisable.
FRONTEND_URL=https://kexpress.exemple.com
# Nombre de proxys de confiance devant le backend (Traefik = 1) : adresse réelle du client
# pour la limitation de débit de la connexion.
DRF_NUM_PROXIES=1
LOGIN_THROTTLE_RATE=30/min
LOGIN_EMAIL_THROTTLE_RATE=10/min

# --- SSO Keycloak (realm « kexpress », cf. docker/keycloak/ et docs/AUTHENTIFICATION.md) ---
# Backend : vérification des jetons (issuer + client) et provisionnement (service account).
OIDC_ENABLED=True
OIDC_ISSUER=https://auth.kaydan-express.ci/realms/kexpress
OIDC_CLIENT_ID=kexpress-web
OIDC_AUDIENCE=
OIDC_DEFAULT_ROLE=requester
KEYCLOAK_SERVER_URL=https://auth.kaydan-express.ci
KEYCLOAK_REALM=kexpress
KEYCLOAK_ADMIN_CLIENT_ID=kexpress-admin
# Secret généré par Keycloak (Clients → kexpress-admin → Credentials) — backend seulement.
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_WEB_CLIENT_ID=kexpress-web
KEYCLOAK_ACTION_REDIRECT_URI=https://kexpress.kaydan-express.ci/login
# Frontend (figés à la compilation) : autorité OIDC et client public ; ACR demandé pour la MFA.
NEXT_PUBLIC_OIDC_AUTHORITY=https://auth.kaydan-express.ci/realms/kexpress
NEXT_PUBLIC_OIDC_CLIENT_ID=kexpress-web
NEXT_PUBLIC_OIDC_MFA_ACR=

# --- Activation, appareils, sessions (backend, cf. docs/AUTHENTIFICATION.md) ---
# OTP email : durée de validité (s), essais, délai entre deux envois.
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# OTP obligatoire sur appareil inconnu ; confiance d'un appareil reconnu (jours).
AUTH_DEVICE_VERIFICATION=True
AUTH_DEVICE_TRUST_DAYS=30
# Durée d'une session ; « Rester connecté » (jours) — jamais de session permanente.
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_ME_DAYS=14
# Cookies HttpOnly de session : Secure obligatoire en HTTPS ; domaine commun si le frontend et
# l'API sont sur deux sous-domaines (ex. .kaydan-express.ci), sinon vide.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
# MFA renforcée (exigée du SSO, quel que soit l'appareil) : valeurs amr / acr acceptées.
OIDC_MFA_AMR_VALUES=otp,mfa,webauthn
OIDC_MFA_ACR_VALUES=gold,mfa,2

# --- Fonds de carte (frontend, figés à la compilation) ---------------------
# Clé CARTO des fonds Plan (Voyager) et Sombre (Dark Matter) : https://carto.com/basemaps/apikey
# C'est une clé NAVIGATEUR (elle figure dans l'URL de chaque tuile) : dans le tableau de bord
# CARTO (dashboard.basemaps.carto.com), restreignez-la aux domaines de l'application
# (« Restrict to specific websites »). Une clé par environnement (développement, production),
# jamais partagée avec un autre projet. Usage commercial gratuit jusqu'à 1 M de tuiles / mois,
# au-delà : offre « Basemaps Commercial » — suivre la consommation dans le tableau de bord.
# Conditions CARTO § 14 : pas de fond CARTO pour la navigation d'un véhicule — les vues
# chauffeur / guidage en course utilisent automatiquement les autres fournisseurs.
# Vérification sans l'afficher : cd frontend && npm run check:carto
# Vide = Plan et Sombre servis par les fournisseurs de secours (OpenStreetMap, Esri).
NEXT_PUBLIC_CARTO_API_KEY=
# Satellite (optionnel) : URL Leaflet {z}/{x}/{y} d'un autre fournisseur. Vide = Esri World Imagery.
# Si une URL est fournie, son ATTRIBUTION est obligatoire (conditions du fournisseur).
NEXT_PUBLIC_MAP_SATELLITE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_MAP_SATELLITE_MAX_ZOOM=
# Fond « Plan » des vues en véhicule (optionnel, fournisseur autorisant la navigation) ;
# vide = OpenStreetMap. Attribution obligatoire si une URL est fournie.
NEXT_PUBLIC_MAP_VEHICLE_URL=
NEXT_PUBLIC_MAP_VEHICLE_ATTRIBUTION=

# --- Superutilisateur initial (OPTIONNEL, accès de secours « break-glass ») -
# ⚠ Si CES DEUX variables sont définies, l'entrypoint CRÉE un superutilisateur à
#   chaque déploiement. Avec Keycloak/OIDC actif, ce compte local n'est qu'un accès
#   de secours : laissez-les VIDES/commentées pour ne créer AUCUN compte automatique.
#   Pour en créer un, décommentez avec VOTRE propre email (jamais une adresse d'exemple).
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# --- Données de démonstration (laisser false en production) -----------------
SEED_DEMO=false

# --- Sauvegardes PostgreSQL (service kexpress-backup) -----------------------
# Intervalle entre deux dumps (secondes ; 86400 = quotidien) et rétention (jours).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- Web Push (VAPID) — générer avec py_vapid -------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@votre-domaine.com

# --- Notifications email (SMTP) ---------------------------------------------
NOTIFY_EMAIL_ENABLED=False
DEFAULT_FROM_EMAIL=noreply@votre-domaine.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- K-BOT (assistant IA, optionnel) ----------------------------------------
# Sans clé, K-BOT bascule sur le moteur heuristique ancré sur les données.
ANTHROPIC_API_KEY=
KBOT_MODEL=claude-3-5-sonnet-latest

# --- Carte / routage & Fuel Intelligence ------------------------------------
OSRM_URL=https://router.project-osrm.org
MAP_COST_PER_KM=350.0
FUEL_PRICE_SOURCE_URL=
FUEL_PRICE_SUPER=875
FUEL_PRICE_GASOIL=655
REVISION_ALERT_PCTS=20,10,5

# --- Kaydan Shield (référentiel RH, synchronisation) — cf. docs/SHIELD.md ---
# Compte de SERVICE Shield sans MFA, rôle minimal : lecture filiales, départements, employés.
# Laisser SHIELD_ENABLED=False tant que le compte de service n'est pas fourni.
SHIELD_ENABLED=False
SHIELD_BASE_URL=https://api.kaydanshield.com
SHIELD_USERNAME=
SHIELD_PASSWORD=
# Champ identifiant de POST /api/v1/auth/login/ (corps non documenté par Shield).
SHIELD_LOGIN_ID_FIELD=email
# Tenant Shield à synchroniser (vide = celui du compte de service).
SHIELD_TENANT_ID=
SHIELD_TIMEOUT_SECONDS=20
SHIELD_PAGE_SIZE=200
SHIELD_VERIFY_TLS=True
# Statuts RH qui ouvrent un accès (active, on_leave, suspended, terminated), séparés par des virgules.
SHIELD_ELIGIBLE_STATUSES=active
# Au-delà (heures sans relecture), plus aucune nouvelle activation.
SHIELD_MAX_STALENESS_HOURS=26

# --- Réglages avancés (optionnels) ------------------------------------------
# Laisser False si Traefik gère déjà la redirection HTTPS.
SECURE_SSL_REDIRECT=False
# HSTS : mettre SECURE_HSTS_SECONDS=0 le temps de valider le certificat TLS.
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# Connexions PostgreSQL persistantes (secondes).
CONN_MAX_AGE=60
# Monitoring Sentry (optionnel) — laisser vide pour désactiver.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=production
# SMTP en TLS implicite (port 465) ; laisser False avec EMAIL_USE_TLS=True (587).
EMAIL_USE_SSL=False
LOG_LEVEL=INFO
CELERY_CONCURRENCY=4
