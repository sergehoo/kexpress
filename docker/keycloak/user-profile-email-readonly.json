{
  "attributes": [
    {"name": "username", "displayName": "${username}", "validations": {"length": {"min": 3, "max": 255}},
     "permissions": {"view": ["admin", "user"], "edit": ["admin"]}},
    {"name": "email", "displayName": "${email}", "validations": {"email": {}, "length": {"max": 255}},
     "required": {"roles": ["user"]}, "permissions": {"view": ["admin", "user"], "edit": ["admin"]}},
    {"name": "firstName", "displayName": "${firstName}", "validations": {"length": {"max": 255}},
     "permissions": {"view": ["admin", "user"], "edit": ["admin", "user"]}},
    {"name": "lastName", "displayName": "${lastName}", "validations": {"length": {"max": 255}},
     "permissions": {"view": ["admin", "user"], "edit": ["admin", "user"]}}
  ],
  "groups": [{"name": "user-metadata", "displayHeader": "User metadata"}]
}
