# Frontend Kexpress — copier en .env.local et adapter.
# La session vit dans des cookies HttpOnly posés par l'API : la page et l'API doivent être sur le
# MÊME site. En local, ouvrez donc http://127.0.0.1:3000 avec cette valeur (localhost:3000 et
# 127.0.0.1:8009 sont deux sites différents : la session serait perdue à chaque rechargement).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8009/api

# --- Fonds de carte (cf. src/lib/mapConfig.ts) -----------------------------
# Clé CARTO (Plan = Voyager, Sombre = Dark Matter) — clé navigateur, PROPRE au développement
# (distincte de la production), restreinte à http://localhost:3000 dans le tableau de bord
# CARTO. Vérification : npm run check:carto ; à l'ouverture d'une carte, la console signale
# une clé refusée. Vide = fonds de secours (OpenStreetMap, Esri).
# ⚠ Variable figée au démarrage : redémarrer `npm run dev` après modification.
NEXT_PUBLIC_CARTO_API_KEY=
# Satellite (optionnel) : vide = Esri World Imagery ; attribution obligatoire si URL fournie.
NEXT_PUBLIC_MAP_SATELLITE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_MAP_SATELLITE_MAX_ZOOM=
# Plan des vues en véhicule (optionnel) : vide = OpenStreetMap (CARTO exclu, conditions § 14).
NEXT_PUBLIC_MAP_VEHICLE_URL=
NEXT_PUBLIC_MAP_VEHICLE_ATTRIBUTION=

# --- SSO Keycloak (OIDC) ---------------------------------------------------
# Laisser VIDE pour désactiver le SSO (connexion locale par mot de passe).
# Renseigner l'autorité du realm pour activer le bouton « Se connecter avec le SSO ».
# NEXT_PUBLIC_OIDC_AUTHORITY=https://auth.datarium-dev.com/realms/kexpress
# NEXT_PUBLIC_OIDC_CLIENT_ID=kexpress-web
# Première connexion sans mot de passe (alias du fournisseur d'activation dans K-access) :
# NEXT_PUBLIC_OIDC_ACTIVATION_IDP=kexpress-activation
# Masquer l'accès secours local (mettre "false") :
# NEXT_PUBLIC_LOCAL_LOGIN=true
